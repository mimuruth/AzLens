# -----------------------------------------------------------------------------
# mcp-memory environment configuration
# -----------------------------------------------------------------------------
# Path to the JSON file used to persist memories. Defaults to ./data/memory.json.
# MEMORY_FILE=./data/memory.json

# Durable backend: set COSMOS_ENDPOINT to use Azure Cosmos DB (AAD / managed
# identity) instead of the local file. Uses database COSMOS_DATABASE (default
# "azlens") and container COSMOS_MEMORY_CONTAINER (default "memory"), partitioned
# by MEMORY_USER_ID (default "shared"). AZURE_CLIENT_ID selects the user-assigned
# identity in Azure.
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_DATABASE=azlens
# COSMOS_MEMORY_CONTAINER=memory
# MEMORY_USER_ID=shared
# AZURE_CLIENT_ID=

# HTTP port for the Streamable HTTP transport (http.js). Defaults to 3000.
# PORT=3008

# Optional. When set, telemetry is exported to Application Insights.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
