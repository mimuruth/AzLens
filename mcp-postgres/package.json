{
  "name": "mcp-postgres",
  "version": "1.0.0",
  "description": "MCP server for read-only PostgreSQL queries and schema introspection",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-postgres": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"import('fs').then(fs => fs.chmodSync('build/index.js', 0o755))\"",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "start:http": "node build/http.js",
    "dev": "tsc && node build/index.js",
    "clean": "node -e \"import('fs').then(fs => fs.rmSync('build', { recursive: true, force: true }))\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "postgres",
    "sql"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.1",
    "pg": "^8.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  }
}
