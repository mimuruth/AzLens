# -----------------------------------------------------------------------------
# mcp-postgres environment configuration
# -----------------------------------------------------------------------------
# Copy to `.env` for local development. The server starts without a connection
# string and returns a clear hint until one is provided.
# -----------------------------------------------------------------------------

# PostgreSQL connection string. Azure Database for PostgreSQL requires SSL.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# SSL: on by default (rejectUnauthorized=false). Set to "disable" for a local
# server without TLS.
# PGSSL=disable

# Query statement timeout in milliseconds (default 15000).
# PG_STATEMENT_TIMEOUT_MS=15000

# HTTP port for the Streamable HTTP transport (http.js). Defaults to 3000.
# PORT=3007

# Optional. When set, telemetry is exported to Application Insights.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
