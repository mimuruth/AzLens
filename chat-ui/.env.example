# -----------------------------------------------------------------------------
# chat-ui environment configuration
# -----------------------------------------------------------------------------
# Copy to `.env.local` for local development. In Azure Container Apps these are
# provided as environment variables / secrets by the Bicep template.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Model provider
# -----------------------------------------------------------------------------
# Pick a provider explicitly, or leave blank to auto-detect from whichever API
# key is set (order: azure -> openai -> anthropic).
# CHAT_PROVIDER=openai

# Option A: Azure OpenAI (used in the deployed Container App)
AZURE_OPENAI_RESOURCE_NAME=my-aoai-resource          # the resource name, not the full URL
AZURE_OPENAI_API_KEY=                                # store as a secret in production
AZURE_OPENAI_DEPLOYMENT=gpt-4o                        # your chat model deployment name
AZURE_OPENAI_API_VERSION=2024-10-21

# Option B: OpenAI (api.openai.com) — simplest for local dev
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Option C: Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Option D: Local, OpenAI-compatible server (LM Studio, Ollama, vLLM, llama.cpp)
# Set the base URL to enable a "Local" provider. The model list is discovered
# automatically from the server's GET /v1/models. No real API key is required.
# LM Studio default base URL is http://localhost:1234/v1.
# LOCAL_OPENAI_BASE_URL=http://localhost:1234/v1
# LOCAL_MODEL=qwen2.5-coder-7b-instruct   # fallback if /models can't be reached
# LOCAL_OPENAI_API_KEY=lm-studio          # any non-empty string; LM Studio ignores it
# LOCAL_LABEL=Local (LM Studio)           # optional display name in the model picker

# -----------------------------------------------------------------------------
# Auto model routing (optional)
# -----------------------------------------------------------------------------
# The "Auto" model option routes simple prompts to a cheap model and complex
# prompts to a powerful one. By default it prefers the free local model for
# simple tasks and the best available cloud model for complex ones. Override the
# picks here as "provider:model" (provider = azure|openai|anthropic|local).
# AUTO_SIMPLE=local:qwen2.5-coder-7b-instruct
# AUTO_COMPLEX=anthropic:claude-3-5-sonnet-latest

# -----------------------------------------------------------------------------
# Cost estimate overrides (optional)
# -----------------------------------------------------------------------------
# The usage/cost footer uses a small built-in price table (USD per 1M tokens).
# Override or add prices without changing code via a JSON object keyed by a
# model-id substring (longest match wins).
# PRICES_JSON={"gpt-5.6-terra":{"input":5,"output":15},"claude-opus-4-8":{"input":15,"output":75}}

# -----------------------------------------------------------------------------
# MCP server endpoints (Streamable HTTP /mcp). For local dev these point at the
# HTTP transport of each server (npm run start:http in each project). Servers
# that are not running are skipped — the chat still works, just without their
# tools.
# -----------------------------------------------------------------------------
MCP_LOCAL_CODER_URL=http://localhost:3001/mcp
MCP_AZLENS_URL=http://localhost:3002/mcp
MCP_PERSONAL_ASSISTANT_URL=http://localhost:3003/mcp
MCP_GITHUB_URL=http://localhost:3004/mcp

# -----------------------------------------------------------------------------
# Observability (optional)
# -----------------------------------------------------------------------------
# When set, the app exports traces, logs and metrics to Application Insights via
# @azure/monitor-opentelemetry (see instrumentation.ts). Leave blank to disable.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
