{
  "name": "mcp-personal-assistant",
  "version": "1.0.0",
  "description": "MCP server for local markdown notes and daily to-do lists",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-personal-assistant": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"import('fs').then(fs => fs.chmodSync('build/index.js', 0o755))\"",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "start:http": "node build/http.js",
    "dev": "tsc && node build/index.js",
    "test": "vitest run",
    "clean": "node -e \"import('fs').then(fs => fs.rmSync('build', { recursive: true, force: true }))\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "notes",
    "todo"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
