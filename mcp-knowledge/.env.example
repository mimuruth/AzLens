# -----------------------------------------------------------------------------
# mcp-knowledge environment configuration
# -----------------------------------------------------------------------------
# Copy to `.env` for local development. The server starts without these and
# returns a clear hint until Azure AI Search is configured.
# -----------------------------------------------------------------------------

# Azure AI Search service endpoint and index to query.
# AZURE_SEARCH_ENDPOINT=https://<service>.search.windows.net
# AZURE_SEARCH_INDEX=my-index

# Auth: either a query API key, or leave it blank to use DefaultAzureCredential
# (az login locally / managed identity in Azure). Reading needs the Search
# Index Data Reader role; ingesting/deleting documents needs Search Index Data
# Contributor; create_index needs Search Service Contributor (or an admin key).
# AZURE_SEARCH_API_KEY=

# Optional field names in your index (defaults shown).
# AZURE_SEARCH_KEY_FIELD=id
# AZURE_SEARCH_CONTENT_FIELD=content
# AZURE_SEARCH_TITLE_FIELD=title

# Optional semantic ranking configuration name (enables semantic queries).
# AZURE_SEARCH_SEMANTIC_CONFIG=

# HTTP port for the Streamable HTTP transport (http.js). Defaults to 3000.
# PORT=3006

# Optional. When set, telemetry is exported to Application Insights.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
