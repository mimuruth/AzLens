{
  "name": "azlens-mcp",
  "version": "1.0.0",
  "description": "MCP server for Azure ARM queries, KQL log analytics, and wiki/docs search",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "azlens-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"import('fs').then(fs => fs.chmodSync('build/index.js', 0o755))\"",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "start:http": "node build/http.js",
    "dev": "tsc && node build/index.js",
    "clean": "node -e \"import('fs').then(fs => fs.rmSync('build', { recursive: true, force: true }))\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "azure",
    "arm",
    "kql"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@azure/identity": "^4.5.0",
    "@azure/arm-resources": "^5.2.0",
    "@azure/monitor-query": "^1.3.0",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
