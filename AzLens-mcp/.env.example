# -----------------------------------------------------------------------------
# AzLens-mcp environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. Do NOT commit `.env`.
#
# Authentication is handled by DefaultAzureCredential, which tries multiple
# sources in order. The simplest local setup is to run `az login` — no secrets
# required. When deployed to Azure Container Apps, assign a managed identity and
# leave the client-secret variables blank.
# -----------------------------------------------------------------------------

# Required: the subscription ARM queries run against.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Optional: only needed for service-principal auth in non-interactive/CI hosts.
# Prefer `az login` locally and Managed Identity in Azure Container Apps.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Optional: default Log Analytics workspace ID used by run_kql_query when one
# is not supplied in the tool call.
# LOG_ANALYTICS_WORKSPACE_ID=

# -----------------------------------------------------------------------------
# search_wiki sources
# -----------------------------------------------------------------------------
# Microsoft Learn (https://learn.microsoft.com) is always enabled — no config.
# To ALSO search an internal Azure DevOps project wiki, set all four below
# (see src/wiki.ts). Add other sources by implementing WikiSource there.
# ADO_ORG=contoso
# ADO_PROJECT=Platform
# ADO_WIKI_ID=Platform.wiki
# ADO_PAT=your-personal-access-token
