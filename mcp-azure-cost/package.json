{
  "name": "mcp-azure-cost",
  "version": "1.0.0",
  "description": "MCP server for Azure cost analysis (Cost Management: actual spend, forecast, budgets)",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-azure-cost": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"import('fs').then(fs => fs.chmodSync('build/index.js', 0o755))\"",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "start:http": "node build/http.js",
    "dev": "tsc && node build/index.js",
    "clean": "node -e \"import('fs').then(fs => fs.rmSync('build', { recursive: true, force: true }))\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "azure",
    "cost-management"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@azure/identity": "^4.5.0",
    "@azure/monitor-opentelemetry": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "typescript": "^7.0.2"
  }
}
