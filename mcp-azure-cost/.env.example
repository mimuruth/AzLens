# -----------------------------------------------------------------------------
# mcp-azure-cost environment configuration
# -----------------------------------------------------------------------------
# Copy to `.env` for local development. All values are optional at startup — the
# server starts without them and returns a clear hint until Azure is configured.
# -----------------------------------------------------------------------------

# The subscription whose costs are queried. Required for any live cost call.
# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# HTTP port for the Streamable HTTP transport (http.js). Defaults to 3000.
# PORT=3005

# Optional. When set, telemetry is exported to Application Insights.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
