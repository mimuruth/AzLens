# -----------------------------------------------------------------------------
# mcp-github environment configuration
# -----------------------------------------------------------------------------
# Copy to `.env` for local development. Authentication is optional.

# Optional: a GitHub token raises the rate limit (5000/h vs 60/h) and allows
# access to private repositories. Create one at
# https://github.com/settings/tokens (fine-grained or classic, read-only is fine).
# GITHUB_TOKEN=

# HTTP port (HTTP transport only).
# PORT=3004

# Optional: export traces/metrics to Application Insights.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
